DATA_DIR=./data
OUTPUT_DIR=./data/outputs
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
SATELLITE_PROVIDER=local
# Register a free account at https://dataspace.copernicus.eu/registration
# Required only to download selected Sentinel-2 scenes; public catalog search needs no account.
# The backend uses CDSE's documented password grant with the public client_id=cdse-public.
# Keep these credentials backend-only. Never put them in frontend/VITE_* variables or Git.
CDSE_USERNAME=
CDSE_PASSWORD=
# Maximum geographic area for one selected-scene acquisition.
MAX_SATELLITE_ACQUISITION_AREA_KM2=1000
AI_MODEL_DIR=./data/models
AI_LANDCOVER_MODEL_MANIFEST=./data/models/sentinel2-landcover.json
MAX_AI_MODEL_BYTES=268435456
MAX_AI_INFERENCE_PIXELS=10000000
SATELLITE_CACHE_DIR=./data/live
SATELLITE_TIMEOUT=30
SATELLITE_MAX_CLOUD_COVER=20
MAX_UPLOAD_BYTES=536870912
MAX_RASTER_BYTES=536870912
MAX_RASTER_PIXELS=1000000
MAX_IMAGERY_PIXELS=200000000
MAX_INPUT_ARRAY_BYTES=134217728
MAX_ANALYSIS_SECONDS=300
MAX_CONCURRENT_ANALYSES=1
# Keep disabled unless persistent storage, a migrated database, an AOI, and CDSE
# credentials are configured. Enabling starts the local daily scheduler.
SATELLITE_MONITOR_ENABLED=false
SATELLITE_MONITOR_TIMEZONE=Asia/Kolkata
SATELLITE_MONITOR_SCHEDULE_TIME=03:00
SATELLITE_MONITOR_AOI=
SATELLITE_MONITOR_LOOKBACK_DAYS=14
SATELLITE_MONITOR_MAX_CLOUD_COVER=20
SATELLITE_MONITOR_MAX_SCENES=3
SATELLITE_MONITOR_MAX_RETRIES=2
SATELLITE_MONITOR_MAX_SCENE_BYTES=536870912
SATELLITE_MONITOR_MAX_STORAGE_BYTES=5368709120
# Defaults outside the source tree (LocalAppData on Windows; XDG data directory elsewhere).
SATELLITE_MONITOR_DATA_DIR=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=satellite-analysis-results
# Accepted values: true/false, 1/0, yes/no. Other values prevent startup.
REQUIRE_AUTH=false
MAX_ARTIFACT_BYTES=536870912
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=1
